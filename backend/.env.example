# ATouPay backend runtime defaults
# Recommended for local testing with a real Firebase DEV project:
# - keep emulator hosts unset
# - set FIREBASE_PROJECT_ID to the same Firebase project used by the Expo app
# - set GOOGLE_APPLICATION_CREDENTIALS to an absolute path outside this repo
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
APP_INVITE_BASE_URL=atoupay://auth/login
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-service-account.json

# Full local emulator mode:
# - set both emulator hosts
# - no FIREBASE_CLIENT_EMAIL required
# - no FIREBASE_PRIVATE_KEY required
# - no GOOGLE_APPLICATION_CREDENTIALS required
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Hybrid local mode:
# - keep FIRESTORE_EMULATOR_HOST
# - remove FIREBASE_AUTH_EMULATOR_HOST
# - prefer ADC or GOOGLE_APPLICATION_CREDENTIALS if needed
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Explicit service-account fallback only:
# - optional for local testing
# - not the preferred Cloud Run strategy
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
