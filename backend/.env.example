# ATouPay backend runtime defaults
# Recommended for local testing with a real Firebase DEV project:
# - keep emulator hosts unset
# - set FIREBASE_PROJECT_ID to the same Firebase project used by the Expo app
# - set GOOGLE_APPLICATION_CREDENTIALS to an absolute path outside this repo
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
APP_INVITE_BASE_URL=atoupay://auth/login
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-service-account.json

# Internal scheduled task protection. Required to run owner proof-review
# reminders through POST /v1/tasks/manual-proof-reminders/run.
INTERNAL_TASK_SECRET=

# Optional outbound invite emails through Resend.
# Leave unset to keep invite delivery as in-app/copy-link only.
# Set both RESEND_API_KEY and EMAIL_FROM to enable email delivery.
# EMAIL_FROM should use a verified Resend sender/domain, for example:
# EMAIL_FROM=ATouPay <invites@yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# Tenant rent payment provider.
# Default is simulated. Moosyl is the first real adapter and must remain test/sandbox
# until merchant, reconciliation, refund, dispute, and launch decisions are approved.
PAYMENT_PROVIDER=simulated
PAYMENT_LIVE_MODE=false
# Required only for an explicitly approved future live Moosyl rollout.
PAYMENT_PROVIDER_LIVE_ACK=
PUBLIC_APP_URL=
PUBLIC_API_URL=
MOOSYL_SECRET_KEY=
MOOSYL_PUBLISHABLE_KEY=
MOOSYL_WEBHOOK_SECRET=

# Full local emulator mode:
# - set both emulator hosts
# - no FIREBASE_CLIENT_EMAIL required
# - no FIREBASE_PRIVATE_KEY required
# - no GOOGLE_APPLICATION_CREDENTIALS required
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Hybrid local mode:
# - keep FIRESTORE_EMULATOR_HOST
# - remove FIREBASE_AUTH_EMULATOR_HOST
# - prefer ADC or GOOGLE_APPLICATION_CREDENTIALS if needed
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Explicit service-account fallback only:
# - optional for local testing
# - not the preferred Cloud Run strategy
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
